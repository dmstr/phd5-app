# prod schwanenbraeu
APP_NAME=phd5-newfs
APP_TITLE=phd5-newfs

YII_ENV=dev
YII_DEBUG=1

APP_CONFIG_FILE=@root/config/_fs_dev.php
APP_MIGRATION_LOOKUP=@vendor/eluhr/yii2-flysystem-rest-api/src/migrations,@root/migrations/fs-dev

# base dir where we will create/expect the fs-local filesystem tree
# the dir must exist and must be writable for the php user!
FILEMANAGER_FS_LOCAL_ROOT=/mnt/storage
